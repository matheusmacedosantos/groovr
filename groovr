#!/usr/bin/env bash
# Groovr CLI launcher — ativa o venv e chama download.py
set -euo pipefail
cd "$(dirname "$0")"

if [[ ! -d venv ]]; then
  echo "venv não encontrado. Rode: python3 -m venv venv && source venv/bin/activate && pip install -r requirements.txt"
  exit 1
fi

source venv/bin/activate
python3 download.py "$@"
